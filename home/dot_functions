# A script containing any custom function definitions

# Set aliases for specified versions of Python (installed via homebrew)
use_python() {
    # Check if a version is provided as an argument
    if [ -z "$1" ]; then
        echo "Usage: use_python <version>"
        return 1
    fi

    # Extract the version from the argument
    local version="$1"
    local python_exec
    local pip_exec

    python_exec="$(command -v "python$version" 2>/dev/null || true)"

    # Check if the requested version of Python exists
    if [ -z "$python_exec" ]; then
	# It doesn't exist... should we install it?
        read -p "Python $version not found. Do you want to install it with Homebrew? (y/n): " answer
        case "$answer" in
            [yY])
                brew install python@"$version"
                if [ $? -ne 0 ]; then
                    echo "Error: Failed to install Python $version with Homebrew."
                    return 1
                fi
                python_exec="$(brew --prefix "python@$version")/bin/python$version"
                ;;
            *)
                echo "Error: Python $version not found. Aborted."
                return 1
                ;;
        esac
    fi

    # Define the aliases for Python and Pip
    pip_exec="${python_exec%/*}/pip$version"
    alias python="$python_exec"
    alias pip="$pip_exec"

    # Inform the user about the aliases
    echo "Aliases set successfully for Python $version."
}

# Activate an environment (Stored in ~/envs)
aenv() {
    # Check if an environment name is provided as an argument
    if [ -z "$1" ]; then
        echo "Usage: activate <environment_name>"
        return 1
    fi

    # Extract the environment name from the argument
    env_name="$1"
    env_path="$HOME/envs/$env_name"

    # Check if the specified environment exists
    if [ ! -d "$env_path" ]; then
        echo "Error: Environment '$env_name' not found in ~/envs/."
        return 1
    fi

    # Activate the Python environment
    source "$env_path/bin/activate" || return 1

    # Update aliases to point to the environment
    alias python="$env_path/bin/python"
    alias pip="command $env_path/bin/pip"

    echo "Activated environment '$env_name'."
}

# Deactivate the current environment and reset python and pip aliases
denv() {
    if ! declare -F deactivate >/dev/null 2>&1; then
        echo "No virtual environment is active."
        return 1
    fi

    unalias python pip 2>/dev/null || true
    deactivate
    echo "Deactivated current environment."
}

# -------- COSMA SSHFS mount helpers --------

COSMA_MOUNT_ROOT="/Users/Shared/Mounts"

_mount_if_needed() {
    local remote="$1"
    local target="$2"

    if mount | grep -q "on $target "; then
        echo "$target already mounted"
        return
    fi

    mkdir -p "$target"
    echo "Mounting $target..."
    sshfs "$remote" "$target" \
        -o reconnect,compression=no,cache=yes,kernel_cache,ServerAliveInterval=15,ServerAliveCountMax=3
}

# -------- Individual mounts --------

mount_snap7()  { _mount_if_needed cosma7:/snap7/scratch/dp004/dc-rope1/ "$COSMA_MOUNT_ROOT/snap7"; }
mount_snap8()  { _mount_if_needed cosma8:/snap8/scratch/dp004/dc-rope1/ "$COSMA_MOUNT_ROOT/snap8"; }
mount_home()   { _mount_if_needed cosma:/cosma/home/dp004/dc-rope1 "$COSMA_MOUNT_ROOT/cosma_home"; }
mount_apps()   { _mount_if_needed cosma:/cosma/apps/dp004/dc-rope1/ "$COSMA_MOUNT_ROOT/cosma_apps"; }
mount_cosma8() { _mount_if_needed cosma8:/cosma8/data/dp004/dc-rope1/ "$COSMA_MOUNT_ROOT/cosma8"; }
mount_cosma7() { _mount_if_needed cosma7:/cosma7/data/dp004/dc-rope1/ "$COSMA_MOUNT_ROOT/cosma7"; }

# -------- Unmount helpers --------

umount_snap7()  { umount "$COSMA_MOUNT_ROOT/snap7"      2>/dev/null || umount -f "$COSMA_MOUNT_ROOT/snap7"; }
umount_snap8()  { umount "$COSMA_MOUNT_ROOT/snap8"      2>/dev/null || umount -f "$COSMA_MOUNT_ROOT/snap8"; }
umount_home()   { umount "$COSMA_MOUNT_ROOT/cosma_home" 2>/dev/null || umount -f "$COSMA_MOUNT_ROOT/cosma_home"; }
umount_apps()   { umount "$COSMA_MOUNT_ROOT/cosma_apps" 2>/dev/null || umount -f "$COSMA_MOUNT_ROOT/cosma_apps"; }
umount_cosma8() { umount "$COSMA_MOUNT_ROOT/cosma8"     2>/dev/null || umount -f "$COSMA_MOUNT_ROOT/cosma8"; }
umount_cosma7() { umount "$COSMA_MOUNT_ROOT/cosma7"     2>/dev/null || umount -f "$COSMA_MOUNT_ROOT/cosma7"; }

mount_all() {
    mount_snap7
    mount_snap8
    mount_home
    mount_apps
    mount_cosma7
    mount_cosma8
}

umount_all() {
    umount_snap7
    umount_snap8
    umount_home
    umount_apps
    umount_cosma7
    umount_cosma8
}

# -------- Jump shortcuts --------

snap7() { mount_snap7 && cd "$COSMA_MOUNT_ROOT/snap7"; }
snap8() { mount_snap8 && cd "$COSMA_MOUNT_ROOT/snap8"; }
c7()    { mount_cosma7 && cd "$COSMA_MOUNT_ROOT/cosma7"; }
c8()    { mount_cosma8 && cd "$COSMA_MOUNT_ROOT/cosma8"; }
chome() { mount_home && cd "$COSMA_MOUNT_ROOT/cosma_home"; }
capps() { mount_apps && cd "$COSMA_MOUNT_ROOT/cosma_apps"; }
