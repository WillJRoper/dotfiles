#!/bin/bash
set -euo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
    echo "This helper supports macOS only" >&2
    exit 1
fi
if ! command -v age >/dev/null 2>&1; then
    echo "age not found; install it with Homebrew" >&2
    exit 1
fi

secrets="$HOME/.config/dotfiles/secrets.sh"
icloud_dir="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Dotfiles"
encrypted="$icloud_dir/secrets.sh.age"

case "${1:-}" in
    backup)
        if [ ! -f "$secrets" ]; then
            echo "Secrets file not found: $secrets" >&2
            exit 1
        fi
        mkdir -p "$icloud_dir"
        temp="$(mktemp "$icloud_dir/.secrets.sh.age.XXXXXX")"
        trap 'rm -f "$temp"' EXIT
        age --passphrase "$secrets" > "$temp"
        chmod 600 "$temp"
        mv "$temp" "$encrypted"
        trap - EXIT
        echo "Encrypted secrets saved to iCloud Drive"
        ;;
    restore)
        if [ ! -f "$encrypted" ]; then
            echo "Encrypted secrets not found: $encrypted" >&2
            exit 1
        fi
        if [ -e "$secrets" ]; then
            echo "Refusing to overwrite existing file: $secrets" >&2
            exit 1
        fi
        mkdir -p "${secrets%/*}"
        chmod 700 "${secrets%/*}"
        umask 077
        temp="$(mktemp "${secrets%/*}/.secrets.sh.XXXXXX")"
        trap 'rm -f "$temp"' EXIT
        age --decrypt "$encrypted" > "$temp"
        bash -n "$temp"
        chmod 600 "$temp"
        mv "$temp" "$secrets"
        trap - EXIT
        echo "Secrets restored to $secrets"
        ;;
    status)
        [ -f "$secrets" ] && echo "Local secrets: present" || echo "Local secrets: missing"
        [ -f "$encrypted" ] && echo "iCloud backup: present" || echo "iCloud backup: missing"
        ;;
    *)
        echo "Usage: dotfiles-secrets-icloud backup|restore|status" >&2
        exit 2
        ;;
esac
