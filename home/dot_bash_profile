# shellcheck shell=bash disable=SC2155

export PATH="$HOME/scripts:/usr/local/sbin:$PATH"

# ssh-add --apple-use-keychain ~/.ssh/id_rsa

[[ -f /usr/local/lib/libmetis.dylib ]] && export METIS_DLL=/usr/local/lib/libmetis.dylib

# Initialize Homebrew on Apple Silicon or Intel macOS.
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export EDITOR="$(command -v nvim 2>/dev/null || command -v vim 2>/dev/null || printf 'vi')"

export STPSF_PATH="$HOME/stpsf-data/"

if command -v brew >/dev/null 2>&1; then
    if brew --prefix llvm >/dev/null 2>&1; then
        export PATH="$(brew --prefix llvm)/bin:$PATH"
    fi
fi

# Enable programmable completion (Homebrew, with fallbacks)
if [[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]]; then
    . "/opt/homebrew/etc/profile.d/bash_completion.sh"
elif [[ -r "/usr/local/etc/profile.d/bash_completion.sh" ]]; then
    . "/usr/local/etc/profile.d/bash_completion.sh"
fi

# Ensure git completion works even when global bash-completion loader is absent
if [[ -r "/opt/homebrew/etc/bash_completion.d/git-completion.bash" ]]; then
    . "/opt/homebrew/etc/bash_completion.d/git-completion.bash"
elif [[ -r "/usr/local/etc/bash_completion.d/git-completion.bash" ]]; then
    . "/usr/local/etc/bash_completion.d/git-completion.bash"
fi

# Make optional Homebrew libraries discoverable without replacing existing flags.
if command -v brew >/dev/null 2>&1; then
    if brew --prefix libomp >/dev/null 2>&1; then
        LIBOMP_PREFIX="$(brew --prefix libomp)"
        export LDFLAGS="-L$LIBOMP_PREFIX/lib ${LDFLAGS:-}"
        export CFLAGS="-I$LIBOMP_PREFIX/include ${CFLAGS:-}"
        export CPPFLAGS="-I$LIBOMP_PREFIX/include ${CPPFLAGS:-}"
    fi
    if brew --prefix tcl-tk >/dev/null 2>&1; then
        TCLTK_PREFIX="$(brew --prefix tcl-tk)"
        export LDFLAGS="-L$TCLTK_PREFIX/lib ${LDFLAGS:-}"
        export CPPFLAGS="-I$TCLTK_PREFIX/include ${CPPFLAGS:-}"
        export PKG_CONFIG_PATH="$TCLTK_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
        export PATH="$TCLTK_PREFIX/bin:$PATH"
    fi
fi

# Machine-local credentials belong here, never in this repository.
[[ -r "$HOME/.config/dotfiles/secrets.sh" ]] && source "$HOME/.config/dotfiles/secrets.sh"

source "$HOME/.bashrc"

command -v neofetch >/dev/null 2>&1 && neofetch
