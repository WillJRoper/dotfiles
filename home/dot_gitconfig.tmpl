[user]
	email = wjr21@sussex.ac.uk
	name = wjr21
	signingkey = {{ .chezmoi.homeDir }}/.ssh/ghub_key.pub
[commit]
	{{- if stat (joinPath .chezmoi.homeDir ".ssh/ghub_key.pub") }}
	gpgsign = true
	{{- else }}
	gpgsign = false
	{{- end }}
[gpg]
	format = ssh
[color]
	ui = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	line-numbers = true
	syntax-theme = "Catppuccin Mocha"

[merge]
	conflictStyle = zdiff3

[init]
	defaultBranch = main
