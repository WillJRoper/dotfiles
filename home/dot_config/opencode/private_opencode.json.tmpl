{{- $home := .chezmoi.homeDir -}}
{{- $secondBrainDir := or (env "SECOND_BRAIN_DIR") (printf "%s/SecondBrain" $home) -}}
{{- $jobsDir := or (env "JOBS_DIR") (printf "%s/Jobs" $home) -}}
{{- $documentsJobsDir := or (env "DOCUMENTS_JOBS_DIR") (printf "%s/Documents/Jobs" $home) -}}
{{- $nasaAdsMcpDir := or (env "NASA_ADS_MCP_DIR") (printf "%s/mcp/nasa-ads-mcp" $home) -}}
{{- $arxivStorageDir := or (env "ARXIV_STORAGE_DIR") (printf "%s/arxiv-papers" $secondBrainDir) -}}
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["uvx", "mcp-obsidian"],
      "enabled": true,
      "environment": {
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "{env:OBSIDIAN_HOST}",
        "OBSIDIAN_PORT": "{env:OBSIDIAN_PORT}"
      }
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "{{ $arxivStorageDir }}"
      ],
      "enabled": true
    },
    "nasa_ads": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "{{ $nasaAdsMcpDir }}",
        "run",
        "python",
        "src/nasa_ads_mcp/server.py"
      ],
      "enabled": true,
      "environment": {
        "ADS_API_TOKEN": "{env:ADS_API_TOKEN}"
      }
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "environment": {
        "AWS_MCP_PROXY_PROFILES": "agent-toolkit"
      }
    }
  },
  "tools": {
    "obsidian_*": false,
    "arxiv_*": false,
    "nasa_ads_*": false
  },
  "permission": {
    "task": {
      "*": "allow"
    },
    "external_directory": {
      "{{ $secondBrainDir }}/**": "allow",
      "{{ $jobsDir }}/**": "allow",
      "{{ $documentsJobsDir }}/**": "allow"
    }
  }
}
